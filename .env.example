# ReviveOS environment template (dev == prod names, see 总览 §7).
# Copy to .env and fill in locally. NEVER commit a filled .env, and never put a
# real key in this template: values here stay empty on purpose (global rule §6.1).
REVIVE_ENV=dev

# --- data plane -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://revive:revive@localhost:5432/revive
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=revive
S3_SECRET_KEY=
S3_BUCKET=capsules

# --- LLM providers (openai | anthropic | custom) ----------------------------
REVIVE_LLM__PROVIDER=custom
REVIVE_LLM__BASE_URL=
REVIVE_LLM__API_KEY=
REVIVE_LLM__MODEL=
REVIVE_LLM__JOB_BUDGET_USD=2.0
REVIVE_LLM__JOB_MAX_CALLS=64
REVIVE_LLM__INPUT_COST_PER_1K=0
REVIVE_LLM__OUTPUT_COST_PER_1K=0
REVIVE_LLM__MAX_RESPONSE_BYTES=4194304

# --- HTTP request ceilings ---------------------------------------------------
REVIVE_HTTP__MAX_REQUEST_BYTES=2097152
REVIVE_HTTP__MAX_CAPSULE_BYTES=67108864

# --- control plane ----------------------------------------------------------
REVIVE_JWT__SECRET=
# API keys expire after this many days; 0 disables expiry (not recommended).
REVIVE_API_KEY__TTL_DAYS=90
# Optional AES-substitute key for admin-managed provider secrets. When empty the
# derived JWT secret is used; changing it makes stored provider keys unreadable.
REVIVE_SECRETS__KEY=
REVIVE_SENTRY_DSN=
# Development only: this email is promoted to admin when registered in memory.
REVIVE_DEV_ADMIN_EMAIL=

# --- sandbox ceilings (four-way limit) --------------------------------------
SANDBOX__CPU_LIMIT=2.0
SANDBOX__MEM_LIMIT=4g
SANDBOX__DISK_LIMIT=10g
SANDBOX__TIMEOUT=300
# Host-visible seccomp profile path; empty uses Docker's default profile.
REVIVE_SANDBOX__SECCOMP_PROFILE=
# Set to 1 in production to fail jobs when a base-image digest cannot be resolved.
REVIVE_SANDBOX__REQUIRE_DIGEST=0

# --- local toolchain (documented in docs/dev-environment.md) ----------------
# Portable git shipped in the workspace; revive_core.gitutil honors this.
REVIVE_GIT_BIN=
