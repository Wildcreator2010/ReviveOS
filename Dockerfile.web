# syntax=docker/dockerfile:1.7
FROM node:20-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
ARG NEXT_PUBLIC_REVIVE_API_URL=/
ENV NEXT_PUBLIC_REVIVE_API_URL=${NEXT_PUBLIC_REVIVE_API_URL}
RUN pnpm --filter web build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/web/out /usr/share/nginx/html
COPY infra/compose/caddy/web-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
