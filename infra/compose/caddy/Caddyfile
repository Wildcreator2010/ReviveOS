{$REVIVE_DOMAIN:localhost} {
  encode gzip zstd
  request_body {
    max_size 64MB
  }
  handle /healthz {
    reverse_proxy api:8000
  }
  handle /readyz {
    reverse_proxy api:8000
  }
  handle /api/* {
    reverse_proxy api:8000 {
      header_up X-Forwarded-For {remote_host}
    }
  }
  handle {
    reverse_proxy web:8080
  }
}
