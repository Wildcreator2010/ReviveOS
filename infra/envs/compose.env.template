# Copy to a deployment-only .env next to the repository root; never commit populated values.
# Image names must exactly match the release owner/repository in GHCR.
REVIVE_API_IMAGE=ghcr.io/<github-owner>/reviveos-api
REVIVE_WORKER_IMAGE=ghcr.io/<github-owner>/reviveos-worker
REVIVE_WEB_IMAGE=ghcr.io/<github-owner>/reviveos-web
API_DIGEST=<64-lowercase-hex-digest>
WORKER_DIGEST=<64-lowercase-hex-digest>
WEB_DIGEST=<64-lowercase-hex-digest>
POSTGRES_DIGEST=<64-lowercase-hex-digest>
REDIS_DIGEST=<64-lowercase-hex-digest>
CADDY_DIGEST=<64-lowercase-hex-digest>
REVIVE_DOMAIN=revive.example.com
DOCKER_GID=<host-docker-group-id>
# Generate each independently with: openssl rand -hex 32
# Hex values are URI-safe and can be used unchanged in Postgres/Redis URLs.
POSTGRES_PASSWORD=<64-hex-characters>
REDIS_PASSWORD=<64-hex-characters>
REVIVE_WORKER_TOKEN=<64-hex-characters>
