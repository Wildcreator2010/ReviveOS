# ReviveOS production environment template. Replace every <REQUIRED_...> via secret manager; never commit values.
REVIVE_ENV=prod
# Compose supplies DATABASE_URL and REDIS_URL to API/worker using the internal network.
# Use lowercase hex secrets only; they are inserted into URI strings unchanged.
REDIS_PASSWORD=<REQUIRED_REDIS_PASSWORD_64_HEX>
POSTGRES_PASSWORD=<REQUIRED_POSTGRES_PASSWORD_64_HEX>
S3_ENDPOINT=<REQUIRED_S3_ENDPOINT>
S3_ACCESS_KEY=<REQUIRED_S3_ACCESS_KEY>
S3_SECRET_KEY=<REQUIRED_S3_SECRET_KEY>
S3_BUCKET=<REQUIRED_S3_BUCKET>
# LLM defaults are optional: configure them in the admin Web settings, or set
# these env values for every worker. The API starts without an LLM key.
# REVIVE_LLM__PROVIDER=custom
# REVIVE_LLM__BASE_URL=https://your-gateway/v1
# REVIVE_LLM__API_KEY=
# REVIVE_LLM__MODEL=
REVIVE_JWT__SECRET=<REQUIRED_JWT_SECRET_32_BYTES_MINIMUM>
# API keys expire after 90 days by default; set 0 only for an explicit exception.
# REVIVE_API_KEY__TTL_DAYS=90
# Point at a host-visible seccomp profile; leave unset for Docker's default profile.
# REVIVE_SANDBOX__SECCOMP_PROFILE=/etc/revive/seccomp.json
# Fail closed when the sandbox base image digest cannot be resolved.
# REVIVE_SANDBOX__REQUIRE_DIGEST=1
# Optional REVIVE_SECRETS__KEY (32+ random bytes) encrypts admin-managed
# provider keys; leave it unset to derive a domain-separated key from the JWT
# secret. Keep API and worker identical if you set it.
REVIVE_WORKER__TOKEN=<REQUIRED_WORKER_TOKEN>
# Optional HTTP ceilings (defaults: 2 MiB JSON / 64 MiB capsule).
# REVIVE_HTTP__MAX_REQUEST_BYTES=2097152
# REVIVE_HTTP__MAX_CAPSULE_BYTES=67108864
# Optional LLM per-job guard rails (defaults: 2 USD / 64 calls).
# REVIVE_LLM__JOB_BUDGET_USD=2.0
# REVIVE_LLM__JOB_MAX_CALLS=64
REVIVE_DEBUG_LLM=false
DEBUG=false
