# Normalize line endings so the repository is identical on every host.
# Windows shell scripts (PowerShell) keep the CRLF their interpreter expects;
# everything else — including the .sh scripts mounted into Linux containers — is LF,
# which is what the "bad interpreter: ^M" failure in the runbooks comes from.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be converted.
*.png binary
*.ico binary
*.jpg binary
*.woff binary
*.woff2 binary
*.gz binary
*.revive binary
